{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jcooley8/pincushion",
  "title": "Pincushion",
  "description": "Stakeholders pin feedback on your live app; your AI agent reads the pins via MCP and fixes them.",
  "websiteUrl": "https://pincushion.io",
  "icons": [
    {
      "src": "https://pincushion.io/icon-128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/jcooley8/pincushion-plugin",
    "source": "github"
  },
  "version": "1.12.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pincushion-mcp",
      "version": "1.12.5",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--ref",
          "value": "mcp-registry",
          "description": "Which listing this install came from (analytics only)."
        }
      ]
    }
  ]
}
